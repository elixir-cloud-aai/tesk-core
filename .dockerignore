# The build context is the whole checkout, with the Git metadata for the
# version (`setuptools_scm`, which takes missing tracked files as changes),
# without local environments, caches and build output
.venv/
.coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
**/__pycache__/
build/
dist/
site/
# Secrets never go into the images
.env
.env.*
!.env.example
